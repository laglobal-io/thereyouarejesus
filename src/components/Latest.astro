---
import type { Post } from '../lib/wp';
import type { SiteSettings } from '../data/defaults';
import PostItem from './PostItem.astro';
interface Props { posts: Post[]; settings: SiteSettings }
const { posts, settings } = Astro.props;
const filters = [
  ['all', 'All'], ['eyewitness-afterlife', 'Eyewitness Afterlife'], ['numbers', 'Numbers'],
  ['everyday-things', 'Everyday Things'], ['nature', 'Nature'],
];
const recent = posts.slice(0, 40);
---
<section id="recent" aria-labelledby="r-title">
  <div class="wrap recent-grid">
    <div>
      <h2 class="sec-title" id="r-title">Latest evidence</h2>
      <div class="filters" role="group" aria-label="Filter posts by category" id="post-filters">
        {filters.map(([k, n], i) => <button class="chip" type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-cat={k}>{n}</button>)}
      </div>
      <ul class="posts" id="posts">
        {recent.map((p, i) => <PostItem post={p} cats hidden={i >= 6} />)}
        <li class="empty" id="posts-empty" hidden>No posts in this category yet. Try another one.</li>
      </ul>
      <p style="margin-top:24px"><a class="text-link" href="/timeline-of-discovery-on-thereyouarejesus/">Browse everything on the timeline</a></p>
    </div>
    <aside class="side" aria-label="More from There You Are Jesus">
      <div class="panel timeline-panel">
        <div class="date">{settings.notice.date}</div>
        <h3>{settings.notice.title}</h3>
        <p>{settings.notice.text}</p>
        <a class="btn btn-gold" href={settings.notice.link}>See what's new</a>
      </div>
      <div class="panel">
        <h3>Search the Bible by keyword</h3>
        <p>Look up any word or phrase on Bible Gateway.</p>
        <form class="search-row" id="bible-form" role="search">
          <label for="bible-q" class="sr-only">Keyword</label>
          <input id="bible-q" type="search" placeholder="Try: seven spirits" autocomplete="off">
          <button class="btn btn-ink" type="submit">Search</button>
        </form>
      </div>
    </aside>
  </div>
</section>
