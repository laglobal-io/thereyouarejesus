---
import type { SiteSettings } from '../data/defaults';
interface Props { settings: SiteSettings }
const { settings } = Astro.props;
const heights = [.78, .86, .93, 1, .93, .86, .78];
const path = 'M30 400 C 8 335, 12 210, 21 120 C 24 80, 27 38, 30 0 C 33 38, 36 80, 39 120 C 48 210, 52 335, 30 400 Z';
const core = 'M30 400 C 20 340, 22 230, 26 150 C 28 110, 29 70, 30 40 C 31 70, 32 110, 34 150 C 38 230, 40 340, 30 400 Z';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="stars" aria-hidden="true"></div>
  <div class="wrap">
    <div class="flames" role="group" aria-label="The Seven Spirits of God. Select a flame to see its name.">
      {settings.spirits.map((s, i) => (
        <button class="flame" type="button" aria-pressed="false" aria-label={s.name} data-i={i}>
          <svg viewBox="0 0 60 400" preserveAspectRatio="none" style={`--h:${heights[i] * 100}%;--d:${i * -0.45}s`} aria-hidden="true">
            <defs>
              <linearGradient id={`g${i}`} x1="0" y1="1" x2="0" y2="0">
                <stop offset="0" stop-color="#FFF4D6" /><stop offset=".35" stop-color="#FFD271" />
                <stop offset=".75" stop-color="#F5B942" /><stop offset="1" stop-color="#E0662F" stop-opacity=".85" />
              </linearGradient>
              <filter id={`f${i}`} x="-80%" y="-10%" width="260%" height="120%"><feGaussianBlur stdDeviation="6" /></filter>
            </defs>
            <path d={path} fill={`url(#g${i})`} filter={`url(#f${i})`} opacity=".75" />
            <path d={path} fill={`url(#g${i})`} />
            <path d={core} fill="#FFF8E6" opacity=".85" />
          </svg>
        </button>
      ))}
    </div>
    <div class="throne-base" aria-hidden="true"></div>
    <div class="spirit-caption" aria-live="polite">
      <div class="name" id="spirit-name">The Seven Spirits of God</div>
      <div class="hint" id="spirit-hint">Seven columns of fire before the Throne. Tap a flame to see its name.</div>
    </div>
    <div class="hero-copy">
      <h1 id="hero-title">{settings.heroTitle}</h1>
      <p>{settings.heroText}</p>
      <div class="ctas">
        <a class="btn btn-gold" href="#testimony">Read My Story</a>
        <a class="btn btn-ghost" href="#evidence">Explore the evidence</a>
      </div>
    </div>
  </div>
</section>
