---
import type { SiteSettings } from '../data/defaults';
interface Props { settings: SiteSettings; eyewitnessPath: string }
const { settings, eyewitnessPath } = Astro.props;
const heights = [.68, .78, .88, 1, .88, .78, .68];
---
<section class="spirits" id="spirits" aria-labelledby="s-title" style="padding-top:0">
  <div class="wrap">
    <h2 class="sec-title" id="s-title">The Seven Spirits of God</h2>
    <p class="lede">Revelation 4:5 describes seven lamps of fire burning before the Throne. John saw them as seven separate columns of fire, each as vast as a star, and all one with the Father, Son and Holy Spirit. Select a spirit to learn more.</p>
    <div class="sp-layout">
      <div class="lamp">
        <div class="lamp-row" role="tablist" aria-label="The Seven Spirits" id="lamp-row">
          {settings.spirits.map((s, i) => (
            <button class="lamp-btn" type="button" role="tab" id={`sp-tab-${i}`} aria-controls="sp-panel" aria-label={s.name} aria-selected="false" tabindex="-1" data-i={i}>
              <span class="col" style={`--h:${heights[i] * 200}px`}></span>
              <span class="num" aria-hidden="true">{i === 3 ? '✝' : i + 1}</span>
            </button>
          ))}
        </div>
        <p class="lamp-note">Use the arrow keys to move between spirits</p>
      </div>
      <div class="sp-panel" id="sp-panel" role="tabpanel" aria-live="polite">
        <p class="pos" id="sp-pos"></p>
        <h3 id="sp-name"></h3>
        <p class="verse" id="sp-verse"></p>
        <p class="ref" id="sp-ref"></p>
        <p class="meaning" id="sp-meaning"></p>
        <div class="sp-nav">
          <button class="btn-line" type="button" id="sp-prev">Previous spirit</button>
          <button class="btn-line" type="button" id="sp-next">Next spirit</button>
          <a class="text-link" href={eyewitnessPath} style="margin-left:6px">Read John's posts on the Seven Spirits</a>
        </div>
      </div>
    </div>
  </div>
  <script type="application/json" id="spirits-data" set:html={JSON.stringify(settings.spirits).replace(/</g, '\\u003c')}></script>
</section>
