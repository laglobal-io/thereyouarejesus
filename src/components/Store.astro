---
import { products, env } from '../data/defaults';
const bars = (h: number[]) => h;
const art: Record<string, number[]> = { print: [52, 60, 68, 78, 68, 60, 52], tee: [30, 36, 42, 48, 42, 36, 30] };
const href = env.store || '#store';
---
<section id="store" aria-labelledby="st-title">
  <div class="wrap">
    <div class="ev-head" style="margin-bottom:0">
      <div>
        <h2 class="sec-title" id="st-title">The store</h2>
        <p class="lede">{env.store ? 'Study guides to read alongside the site, and the Seven Spirits artwork to keep in your home.' : 'Opening soon: study guides to read alongside the site, and the Seven Spirits artwork to keep in your home.'}</p>
      </div>
      {env.store && <a class="text-link" href={env.store}>See all products</a>}
    </div>
    <div class="store-grid">
      {products.map((p) => (
        <a class="product" href={href}>
          {p.art === 'guide'
            ? <div class="art guide" aria-hidden="true"><strong>The Biblical Trail of Sevens</strong><span>Study guide, Genesis to Revelation</span></div>
            : <div class={`art ${p.art}`} aria-hidden="true">{bars(art[p.art]).map((h) => <i style={`height:${h}%`}></i>)}</div>}
          <div class="kind">{p.kind}</div>
          <h3>{p.name}</h3>
          <div class="p">{p.price}</div>
        </a>
      ))}
    </div>
  </div>
</section>
