---
import ProductArt from './ProductArt.astro';
import { PRODUCTS, fromPrice } from '../data/store';
import { productImages } from '../lib/store-images';
const featured = PRODUCTS.slice(0, 3);
---
<section id="store" aria-labelledby="st-title">
  <div class="wrap">
    <div class="ev-head" style="margin-bottom:0">
      <div>
        <h2 class="sec-title" id="st-title">The store</h2>
        <p class="lede">Seven Spirits artwork for your home, apparel and study guides. Every purchase supports the ministry.</p>
      </div>
      <a class="btn btn-gold" href="/store/">Shop all products</a>
    </div>
    <div class="store-grid">
      {featured.map((p) => (
        <a class="product" href={`/store/${p.id}/`}>
          <ProductArt art={p.art} img={productImages(p.id)[0]} alt={p.name} />
          <div class="kind">{p.kind}</div>
          <h3>{p.name}</h3>
          <div class="p">{fromPrice(p)}</div>
        </a>
      ))}
    </div>
  </div>
</section>
