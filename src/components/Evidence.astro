---
import type { Category } from '../lib/wp';
interface Props { cats: Category[] }
const { cats } = Astro.props;
const by = (slug: string) => cats.find((c) => c.slug === slug);
const eye = by('eyewitness-afterlife');
const indirect = [
  { c: by('numbers'), text: 'Repeating patterns from Heaven to earth.', tint: 'numbers' },
  { c: by('everyday-things'), text: 'Meaningful coincidences in ordinary life.', tint: 'everyday' },
  { c: by('nature'), text: "Messages delivered through God's creation.", tint: 'nature' },
].filter((x) => x.c);
const series = ['the-7-series', '11-12-series'].map(by).filter(Boolean) as Category[];
const plural = (n: number) => `${n} post${n === 1 ? '' : 's'}`;
---
<section class="evidence" id="evidence" aria-labelledby="e-title">
  <div class="wrap">
    <div class="ev-head">
      <div>
        <h2 class="sec-title" id="e-title">Four categories of evidence</h2>
        <p class="lede">One firsthand account, and three ways God keeps speaking through layered coincidences in the world around us.</p>
      </div>
    </div>
    <div class="ev-grid">
      {eye && (
        <a class={`ev-direct${eye.image ? ' has-img' : ''}`} href={eye.path}>
          <span class="ev-img" style={eye.image ? `background-image:url('${eye.image}')` : ''} aria-hidden="true"></span>
          <span class="shade" aria-hidden="true"></span>
          <div class="ev-body">
            <div class="kind">Direct evidence</div>
            <h3>{eye.name}</h3>
            <p>{eye.description || "Firsthand accounts of God's Throne, the Seven Spirits and Jesus Christ, and the interactions with God that followed."}</p>
            <div class="count">{plural(eye.count)}</div>
          </div>
        </a>
      )}
      <div class="ev-indirect">
        <p class="kind">Indirect evidence through multi-layered coincidences</p>
        {indirect.map(({ c, text, tint }) => (
          <a class={`ev-tile${c!.image ? ' has-img' : ''}`} data-host={tint} href={c!.path}>
            <span class="ev-img" style={c!.image ? `background-image:url('${c!.image}')` : ''} aria-hidden="true"></span>
            <span class="shade" aria-hidden="true"></span>
            <div class="ev-body">
              <div><h3>{c!.name}</h3><p>{c!.description || text}</p></div>
              <span class="n">{plural(c!.count)}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
    <div class="ev-foot">
      {series.map((c) => <a class="text-link" href={c.path}>The {c.name}</a>)}
    </div>
  </div>
</section>
