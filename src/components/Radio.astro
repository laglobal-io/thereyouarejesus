---
import type { Station } from '../data/defaults';
interface Props { stations: Station[] }
const { stations } = Astro.props;
const genres = ['All', ...new Set(stations.map((s) => s.genre))];
const playIcon = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4l13 8-13 8z" fill="currentColor"/></svg>';
---
<section id="radio" aria-labelledby="rd-title">
  <div class="wrap">
    <h2 class="sec-title" id="rd-title">Live Christian radio</h2>
    <p class="lede">Worship, gospel, hymns and Bible teaching, streaming live from trusted Christian networks.</p>
    <div class="filters" role="group" aria-label="Filter stations by genre" id="radio-filters">
      {genres.map((g, i) => <button class="chip" type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-g={g}>{g}</button>)}
      <button class="chip" type="button" aria-pressed="false" data-g="Discover" id="discover-chip" hidden>Discover more</button>
    </div>
    <p class="radio-status" id="radio-status" aria-live="polite"></p>
    <ul class="stations" id="stations">
      {stations.map((s, i) => (
        <li data-g={s.genre}>
          <button class="station" type="button" aria-pressed="false" aria-label={`Play ${s.name}`}
            data-key={`s${i}`} data-name={s.name} data-genre={s.genre} data-site={s.site} data-stream={s.stream || undefined}>
            <span class="pb" set:html={playIcon}></span>
            <span class="g">{s.genre}</span><span class="nm">{s.name}</span><span class="ds">{s.description}</span>
          </button>
        </li>
      ))}
    </ul>
    <audio id="radio-audio" preload="none"></audio>
    <!-- Player bar that slides up from the bottom while a station is on -->
    <div class="dock" id="radio-dock" hidden role="region" aria-label="Radio player">
      <div class="dock-in">
        <span class="dock-logo" id="dock-logo" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 0 0-9 9h2a7 7 0 0 1 14 0h2a9 9 0 0 0-9-9zm0 4a5 5 0 0 0-5 5h2a3 3 0 0 1 6 0h2a5 5 0 0 0-5-5zm0 4a1 1 0 1 0 0 2 1 1 0 0 0 0-2z" fill="currentColor"/></svg></span>
        <div class="dock-text">
          <div class="dock-station"><span class="live-pill" id="dock-live" hidden><i aria-hidden="true"></i>Live</span><span id="dock-station"></span></div>
          <div class="dock-title" id="dock-title" aria-live="polite"></div>
          <div class="dock-artist" id="dock-artist"></div>
        </div>
        <label class="dock-vol"><span class="sr-only">Volume</span><input type="range" id="radio-vol" min="0" max="1" step="0.05" value="0.8" aria-label="Volume"></label>
        <button class="dock-play" type="button" id="dock-toggle" aria-label="Pause">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path id="dock-icon" d="M6 4h4v16H6zM14 4h4v16h-4z" fill="currentColor"/></svg>
        </button>
        <button class="dock-close" type="button" id="dock-close" aria-label="Close the radio player">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </div>
    </div>
    <p class="radio-note">Stations are independent ministries and are not affiliated with ThereYouAreJesus. Station directory by <a href="https://www.radio-browser.info/" style="color:inherit">Radio Browser</a>.</p>
  </div>
</section>
