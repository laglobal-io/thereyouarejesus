---
import Base from '../../layouts/Base.astro';
import PostItem from '../../components/PostItem.astro';
import { getCategories, getPosts, ancestorsOf, type Category, type Post } from '../../lib/wp';

export async function getStaticPaths() {
  const [cats, posts] = await Promise.all([getCategories(), getPosts()]);
  return Promise.all(cats
    .filter((c) => c.path.startsWith('/category/'))
    .map(async (c) => ({
      params: { path: c.path.replace(/^\/category\/|\/$/g, '') },
      props: {
        cat: c, posts: posts.filter((p) => p.catSlugs.includes(c.slug)), children: cats.filter((x) => x.parent === c.id && x.count > 0),
        // A series without its own image (like the 7 Series) uses its parent category's image.
        image: c.image || (await ancestorsOf(c)).find((a) => a.image)?.image || '',
      },
    })));
}
interface Props { cat: Category; posts: Post[]; children: Category[]; image: string }
const { cat, posts, children, image } = Astro.props;
---
<Base title={`${cat.name} | There You Are Jesus!`} description={cat.description || `Posts in ${cat.name} on ThereYouAreJesus.`} image={image || undefined}>
  <header class={`page-hero cat-hero${image ? ' has-img' : ''}`}>
    {image && <span class="ev-img" style={`background-image:url('${image}')`} aria-hidden="true"></span>}
    {image && <span class="shade" aria-hidden="true"></span>}
    <div class="wrap">
      <a href="/#evidence">Evidence</a>
      <h1>{cat.name}</h1>
      {cat.description && <p>{cat.description}</p>}
    </div>
  </header>
  <section style="padding:0"><div class="wrap post-body" style="max-width:860px">
    {children.length > 0 && (
      <div class="filters" style="margin-top:0">
        {children.map((c) => <a class="chip" href={c.path} style="text-decoration:none">{c.name}</a>)}
      </div>
    )}
    <ul class="posts">
      {posts.length
        ? posts.map((p) => <PostItem post={p} excerpt />)
        : <li class="empty">No posts here yet. New evidence is added regularly.</li>}
    </ul>
  </div></section>
</Base>
