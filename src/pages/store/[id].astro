---
import Base from '../../layouts/Base.astro';
import ProductArt from '../../components/ProductArt.astro';
import { PRODUCTS, money, fromPrice, type Product } from '../../data/store';
import { productImages } from '../../lib/store-images';

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({ params: { id: p.id }, props: { p } }));
}
interface Props { p: Product }
const { p } = Astro.props;
const imgs = productImages(p.id);
const others = PRODUCTS.filter((x) => x.id !== p.id).slice(0, 3);
---
<Base title={`${p.name} | Store | There You Are Jesus!`} description={p.blurb} image={imgs[0] ? new URL(imgs[0], Astro.site).toString() : undefined}>
  <section style="padding-top:36px">
    <div class="wrap">
      <p class="crumbs" style="margin:0 0 20px"><a href="/store/" class="text-link">Store</a></p>
      <div class="pdp">
        <div class="pdp-media">
          <div class="pdp-main"><ProductArt art={p.art} img={imgs[0]} alt={p.name} eager /></div>
          {imgs.length > 1 && <div class="pdp-thumbs">{imgs.map((src, i) => <button type="button" data-src={src} aria-label={`Photo ${i + 1}`}><img src={src} alt="" loading="lazy" /></button>)}</div>}
        </div>
        <div class="pdp-info">
          <div class="kind">{p.kind}</div>
          <h1>{p.name}</h1>
          <p class="pdp-price" id="pdp-price">{fromPrice(p)}</p>
          {p.description.map((d) => <p class="pdp-desc">{d}</p>)}
          <form class="pdp-form" id="pdp-form" data-id={p.id}>
            {p.options && (
              <fieldset>
                <legend>{p.optionLabel}</legend>
                <div class="opt-row">
                  {p.options.map((o, i) => (
                    <label class="opt"><input type="radio" name="option" value={o.label} data-price={o.price} checked={i === 0} /><span>{o.label}</span></label>
                  ))}
                </div>
              </fieldset>
            )}
            {!p.digital && (
              <div class="qty"><label for="pdp-qty">Quantity</label>
                <div class="qty-in"><button type="button" data-step="-1" aria-label="One fewer">−</button><input id="pdp-qty" type="number" min="1" max="20" value="1" inputmode="numeric"><button type="button" data-step="1" aria-label="One more">+</button></div>
              </div>
            )}
            <button class="btn btn-gold pdp-add" type="submit">Add to cart</button>
            <p class="form-msg" id="pdp-msg" aria-live="polite"></p>
          </form>
          <ul class="pdp-notes">
            {p.digital ? <li>Instant download after checkout, plus a copy by email.</li> : <li>Printed and shipped for you, usually within 2 to 7 business days.</li>}
            <li>Secure checkout by Stripe: cards, Apple Pay and Google Pay.</li>
            <li>Questions about an order? <a class="text-link" href="/share/">Contact us</a>.</li>
          </ul>
        </div>
      </div>
      <h2 class="sec-title" style="margin-top:72px">You might also like</h2>
      <ul class="store-grid">
        {others.map((o) => <li><a class="product" href={`/store/${o.id}/`}><ProductArt art={o.art} img={productImages(o.id)[0]} alt={o.name} /><div class="kind">{o.kind}</div><h3>{o.name}</h3><div class="p">{fromPrice(o)}</div></a></li>)}
      </ul>
    </div>
  </section>
</Base>
