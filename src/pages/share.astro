---
import Base from '../layouts/Base.astro';
import { topics } from '../data/defaults';
import { getPosts } from '../lib/wp';
const posts = (await getPosts()).slice(0, 60);
---
<Base title="Share your thoughts | There You Are Jesus!" description="Ask John Levay a question, share your own experience, request prayer, or be a guest on the podcast.">
  <div id="share-page">
    <div class="share-hero">
      <div class="wrap">
        <a class="back" href="/">Back to home</a>
        <h1 id="share-h1">Share your thoughts</h1>
        <p>Every message comes straight to John. Tell us as much or as little as you'd like.</p>
      </div>
    </div>
    <div class="wrap form-wrap">
      <form id="share-form" novalidate data-started={Date.now()}>
        <fieldset>
          <legend>What would you like to share?</legend>
          <div class="topic-opts">
            {topics.map((t) => (
              <div class="topic-opt">
                <input type="radio" name="topic" id={`tp-${t.key}`} value={t.key} data-heading={t.heading} data-label={t.label} data-help={t.help}>
                <label for={`tp-${t.key}`}><strong>{t.name}</strong><span>{t.sub}</span></label>
              </div>
            ))}
          </div>
          <span class="err" id="err-topic" hidden>Choose a topic so we know how to help.</span>
        </fieldset>

        <fieldset>
          <legend>About you</legend>
          <div class="row2">
            <div class="field"><label for="f-name">Name</label><input type="text" id="f-name" name="name" autocomplete="name"><span class="err" id="err-name" hidden>Enter your name.</span></div>
            <div class="field"><label for="f-email">Email</label><input type="email" id="f-email" name="email" autocomplete="email"><span class="err" id="err-email" hidden>Enter a full email address, like you@example.com.</span></div>
          </div>
          <div class="field"><label for="f-loc">Where are you writing from? <span class="help" style="display:inline">(optional)</span></label><input type="text" id="f-loc" name="location" placeholder="City, state or country" autocomplete="address-level2"></div>
        </fieldset>

        <fieldset>
          <legend>Your message</legend>
          <div class="cond" data-for="story" hidden>
            <div class="row2">
              <div class="field"><label for="f-kind">What kind of experience?</label>
                <select id="f-kind" name="kind"><option value="">Choose one</option><option>Eyewitness afterlife</option><option>Nature</option><option>Numbers</option><option>Everyday things</option><option>Not sure</option></select></div>
              <div class="field"><label for="f-when">When did it happen? <span class="help" style="display:inline">(optional)</span></label><input type="date" id="f-when" name="when"></div>
            </div>
          </div>
          <div class="cond" data-for="guest" hidden>
            <div class="field"><label for="f-phone">Phone <span class="help" style="display:inline">(optional, for scheduling)</span></label><input type="tel" id="f-phone" name="phone" autocomplete="tel"></div>
            <label class="choice"><input type="checkbox" id="f-record" name="record" value="yes"> I'm open to recording a conversation with John for the podcast</label>
          </div>
          <div class="cond" data-for="feedback" hidden>
            <div class="field"><label for="f-post">Which post?</label>
              <select id="f-post" name="post"><option value="">Choose a post</option>{posts.map((p) => <option>{p.title}</option>)}</select></div>
          </div>
          <div class="cond" data-for="prayer" hidden>
            <div class="note">Prayer requests are kept private and are never published on the site.</div>
          </div>
          <div class="field">
            <label for="f-msg" id="msg-label">Your message</label>
            <span class="help" id="msg-help" hidden></span>
            <textarea id="f-msg" name="message"></textarea>
            <span class="err" id="err-msg" hidden>Write a message before sending.</span>
          </div>
          <div class="hp" aria-hidden="true"><label for="f-website">Leave this empty</label><input type="text" id="f-website" name="website" tabindex="-1" autocomplete="off"></div>
        </fieldset>

        <fieldset id="perm-set">
          <legend>Can we share this?</legend>
          <label class="choice"><input type="radio" name="perm" value="first-name" checked> Yes, with my first name</label>
          <label class="choice"><input type="radio" name="perm" value="anonymous"> Yes, anonymously</label>
          <label class="choice"><input type="radio" name="perm" value="private"> No, keep it private</label>
        </fieldset>

        <label class="choice" style="margin-bottom:24px"><input type="checkbox" id="f-sub" name="subscribe" value="yes"> Email me new posts from ThereYouAreJesus</label>
        <button class="btn btn-gold" type="submit" id="send-btn">Send to John</button>
        <p class="radio-note" style="margin-top:14px">By sending, you agree to our <a href="/submissions/" style="color:inherit">Submission Policy</a>. See how we protect your information in our <a href="/privacy/" style="color:inherit">Privacy Policy</a>.</p>
        <p class="form-msg" id="send-error" aria-live="assertive" style="margin-top:12px"></p>
      </form>

      <div class="sent" id="sent" hidden tabindex="-1">
        <h2>Thank you, your message was sent.</h2>
        <p class="lede" id="sent-msg"></p>
        <p style="margin-top:24px"><a class="btn btn-ink" href="/">Back to home</a> <a class="text-link" href="/share/" style="margin-left:14px">Send another message</a></p>
      </div>
    </div>
  </div>
</Base>
